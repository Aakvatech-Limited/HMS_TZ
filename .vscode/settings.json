{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./hms_tz",
        "-p",
        "*_test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,

    // Files under www/ are Jinja templates, not plain HTML. Their <script>
    // blocks contain {% %} tags that are only valid JavaScript after Frappe
    // renders them server-side.
    "html.validate.scripts": false,

    // Git commit message settings
    "git.inputValidationSubjectLength": 72,
    "git.inputValidationLength": 500,
    "git.inputValidation": true,
    
    // Conventional Commits settings
    "conventionalCommits.scopes": [
        "nhif",
        "healthcare",
        "patient",
        "billing",
        "ui",
        "api",
        "config",
        "docs"
    ],
    "conventionalCommits.gitmoji": false,
    
    // GitHub Copilot settings
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true  // Enable Copilot for commit messages
    }
}
